{
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "^Bash$",
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/relay.py\" capture --directory \"${HOME}/.config/agent-repair/hooks\"",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/relay.py\" flush --directory \"${HOME}/.config/agent-repair/hooks\"",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "python3 \"${PLUGIN_ROOT}/hooks/relay.py\" flush --directory \"${HOME}/.config/agent-repair/hooks\"",
            "async": true,
            "timeout": 5
          }
        ]
      }
    ]
  }
}
